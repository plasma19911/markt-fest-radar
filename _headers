/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(self)
  X-Robots-Tag: noindex, nofollow, noarchive

/
  Cache-Control: no-store, no-cache, must-revalidate
/index.html
  Cache-Control: no-store, no-cache, must-revalidate
/app.js
  Cache-Control: no-store, no-cache, must-revalidate
/styles.css
  Cache-Control: no-store, no-cache, must-revalidate
/styles/*
  Cache-Control: no-store, no-cache, must-revalidate
/sw.js
  Cache-Control: no-store, no-cache, must-revalidate
